{
    // Debugging (F5) needs the CodeLLDB extension: vadimcorp.vscode-lldb
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Panel (mock)",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["build", "--bin=klip-boy", "--package=klip-boy"],
                "filter": { "name": "klip-boy", "kind": "bin" }
            },
            "env": {
                "MOONRAKER_URL": "ws://127.0.0.1:7125/websocket",
                "KLIP_BOY_CONFIG": "${workspaceFolder}/target/dev-mock.toml"
            },
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Mock Moonraker"
        },
        {
            "name": "Panel (mock, 800x480)",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["build", "--bin=klip-boy", "--package=klip-boy"],
                "filter": { "name": "klip-boy", "kind": "bin" }
            },
            "env": {
                "MOONRAKER_URL": "ws://127.0.0.1:7125/websocket",
                "KLIP_BOY_CONFIG": "${workspaceFolder}/target/dev-mock.toml",
                "KLIP_BOY_SCREEN": "800x480"
            },
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Mock Moonraker"
        },
        {
            "name": "Panel (printer)",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["build", "--bin=klip-boy", "--package=klip-boy"],
                "filter": { "name": "klip-boy", "kind": "bin" }
            },
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Mock Moonraker",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["build", "--example=mock_moonraker", "--package=klip-boy"],
                "filter": { "name": "mock_moonraker", "kind": "example" }
            },
            "cwd": "${workspaceFolder}"
        }
    ]
}
