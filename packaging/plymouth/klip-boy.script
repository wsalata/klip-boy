# Klipper Helm boot splash: "Please stand by" exactly where the panel's welcome screen draws it, so the
# hand-over to the panel (plymouth quit --retain-splash) shows no jump.

# Theme.bg (ui/theme.slint)
Window.SetBackgroundTopColor(0.016, 0.075, 0.035);
Window.SetBackgroundBottomColor(0.016, 0.075, 0.035);

# The panel's scale: the UI is designed for 800x480 and never shrinks (main.rs, scale_for)
screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
scale = Math.Min(screen_w / 800, screen_h / 480);
if (scale < 1)
    scale = 1;

# logo.png is a copy of ui/icons/standby.png (900 x 620), which StandBy (ui/dialogs.slint) draws
# 310 logical pixels high in the middle of the screen
logo_h = 310;
logo_w = logo_h * 900 / 620;
logo = Image("logo.png").Scale(logo_w * scale, logo_h * scale);

sprite = Sprite(logo);
sprite.SetX(Window.GetX() + (screen_w - logo_w * scale) / 2);
sprite.SetY(Window.GetY() + (screen_h - logo_h * scale) / 2);
