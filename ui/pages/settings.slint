import { Theme } from "../theme.slint";
import { Overlay, Settings, Strings, Screensaver } from "../state.slint";
import { Btn, BtnKind, Card, Caption, SettingRow } from "../widgets.slint";
import { ScrollView, ListView } from "std-widgets.slint";

// Cancel and Save for the panel settings (also used by the Presets page, saved with them), and
// the error from the last save.
export component SaveBar inherits VerticalLayout {
    spacing: Theme.gap;
    HorizontalLayout {
        spacing: Theme.gap;
        alignment: end;
        // Back to the saved values
        Btn { text: @tr("Cancel"); kind: BtnKind.ghost; width: 150px; clicked => { Settings.load(); } }
        Btn { text: @tr("Save"); kind: BtnKind.accent; width: 150px; clicked => { Settings.save(); } }
    }
    if Settings.error-code != "": Text {
        text: Strings.settings-error(Settings.error-code, Settings.error-arg);
        color: Theme.danger;
        font-size: Theme.font-s;
        wrap: word-wrap;
    }
}

// One language in the picker, like a Wi-Fi network row: the chosen one is lit and marked.
component LanguageRow inherits Rectangle {
    in property <string> name;
    in property <string> code;
    in property <bool> current;
    callback clicked();
    height: 42px;
    background: ta.pressed ? Theme.surface-2 : root.current ? Theme.accent.transparentize(0.88) : transparent;
    accessible-role: button;
    accessible-label: root.name;
    accessible-action-default => { root.clicked(); }

    if root.current: Rectangle { x: 0; width: 3px; background: Theme.accent; }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.name;
            color: root.current ? Theme.accent : Theme.text;
            font-weight: root.current ? 700 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        // Language code; none for the system default
        if root.code != "auto": Caption { text: root.code.to-uppercase(); horizontal-stretch: 0; }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
    ta := TouchArea {
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { Screensaver.activity(); } }
        clicked => { root.clicked(); }
    }
}

// One screen colour: a patch of it and its name; the chosen one is framed.
component PhosphorKey inherits Rectangle {
    in property <string> name;
    in property <color> swatch;
    in property <bool> active;
    callback clicked();
    min-height: 44px;
    horizontal-stretch: 1;
    background: ta.pressed ? Theme.surface-2 : root.active ? Theme.accent.transparentize(0.88) : transparent;
    border-width: root.active ? 2px : 1px;
    border-color: root.active ? Theme.accent : Theme.border;
    accessible-role: button;
    accessible-label: root.name;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        padding-left: 8px;
        padding-right: 8px;
        VerticalLayout {
            alignment: center;
            Rectangle { width: 14px; height: 14px; background: root.swatch; }
        }
        Text {
            text: root.name;
            color: Theme.text;
            font-size: Theme.font-s;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    ta := TouchArea {
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { Screensaver.activity(); } }
        clicked => { root.clicked(); }
    }
}

export component SettingsPage inherits Rectangle {
    // Language names are written in their own language, so they are not translated
    property <[{ code: string, name: string }]> languages: [
        { code: "auto", name: @tr("System") },
        { code: "cs", name: "Čeština" },
        { code: "de", name: "Deutsch" },
        { code: "en", name: "English" },
        { code: "fr", name: "Français" },
        { code: "it", name: "Italiano" },
        { code: "pl", name: "Polski" },
    ];
    property <bool> choosing-language;

    pure function language-name(code: string) -> string {
        if (code == "cs") { return "Čeština"; }
        if (code == "de") { return "Deutsch"; }
        if (code == "en") { return "English"; }
        if (code == "fr") { return "Français"; }
        if (code == "it") { return "Italiano"; }
        if (code == "pl") { return "Polski"; }
        return @tr("System");
    }

    VerticalLayout {
        padding: Theme.gap;
        spacing: Theme.gap;

        SaveBar {}

        HorizontalLayout {
            spacing: Theme.gap;
            vertical-stretch: 1;

            Card {
                horizontal-stretch: 1;
                // Scrolls when the screen is too short for all rows
                ScrollView {
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    Caption { text: @tr("Connection"); }
                    SettingRow {
                        label: "Moonraker";
                        value: Settings.url;
                        clicked => { Overlay.ask-text("url", @tr("Moonraker address (ws://host:7125/websocket)"), Settings.url); }
                    }
                    Caption { text: @tr("Manual movement"); }
                    SettingRow {
                        label: @tr("XY speed");
                        value: round(Settings.xy-speed) + " mm/s";
                        clicked => { Overlay.ask-number("xy", @tr("XY speed [mm/s]"), Settings.xy-speed, " mm/s"); }
                    }
                    SettingRow {
                        label: @tr("Z speed");
                        value: round(Settings.z-speed) + " mm/s";
                        clicked => { Overlay.ask-number("z", @tr("Z speed [mm/s]"), Settings.z-speed, " mm/s"); }
                    }
                    SettingRow {
                        label: @tr("Language");
                        value: root.language-name(Settings.language);
                        clicked => { root.choosing-language = true; }
                    }
                    // Applied on Save, like the language
                    Caption { text: @tr("Screen colour"); }
                    HorizontalLayout {
                        spacing: 4px;
                        for c[i] in [
                            { code: "green", name: @tr("Green") },
                            { code: "amber", name: @tr("Amber") },
                            { code: "white", name: @tr("White") },
                            { code: "blue", name: @tr("Blue") },
                        ]: PhosphorKey {
                            name: c.name;
                            swatch: Theme.swatches[i];
                            active: Settings.phosphor == c.code;
                            clicked => { Settings.phosphor = c.code; }
                        }
                    }
                    Caption { text: @tr("Screen saver"); }
                    HorizontalLayout {
                        spacing: 4px;
                        for option in [
                            { minutes: 0, name: @tr("Off") },
                            { minutes: 2, name: @tr("{} min", 2) },
                            { minutes: 5, name: @tr("{} min", 5) },
                            { minutes: 10, name: @tr("{} min", 10) },
                            { minutes: 30, name: @tr("{} min", 30) },
                        ]: Btn {
                            text: option.name;
                            font-size: Theme.font-s;
                            min-height: 44px;
                            active: Settings.screensaver-minutes == option.minutes;
                            clicked => { Settings.screensaver-minutes = option.minutes; }
                        }
                    }
                    Caption {
                        text: @tr("File: {}", Settings.config-path);
                        wrap: word-wrap;
                        font-size: 12px;
                    }
                }
                }
            }
        }
    }

    if root.choosing-language: Rectangle {
        background: Theme.scrim;
        TouchArea { clicked => { root.choosing-language = false; } }
        Card {
            width: min(root.width - 2 * Theme.gap, 420px);
            height: picker.preferred-height;
            background: Theme.surface;
            TouchArea {}  // swallows taps so they do not close the picker
            picker := VerticalLayout {
                padding: 14px;
                spacing: 6px;
                Caption { text: @tr("Language"); }
                // A list as for Wi-Fi networks; scrolls when the screen is too short
                ListView {
                    height: min(root.languages.length * 42px, root.height - 2 * Theme.gap - 60px);
                    for lang in root.languages: LanguageRow {
                        name: lang.name;
                        code: lang.code;
                        current: Settings.language == lang.code;
                        clicked => {
                            Settings.language = lang.code;
                            root.choosing-language = false;
                        }
                    }
                }
            }
        }
    }
}