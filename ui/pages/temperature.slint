import { Theme } from "../theme.slint";
import { Printer, Actions, Overlay, Heater, Fan, Strings, Screensaver, TempSample } from "../state.slint";
import { Btn, BtnKind, Card, Caption, Bar, FanSpeeds } from "../widgets.slint";
import { ScrollView } from "std-widgets.slint";

component HeaterRow inherits Rectangle {
    in property <Heater> heater;
    height: 64px;
    background: ta.pressed ? Theme.surface-2 : transparent;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 1;
            // Long names (e.g. "Raspberry pi") take a second line
            Text { text: Strings.heater-name(root.heater); color: Theme.text; wrap: word-wrap; overflow: elide; }
            if root.heater.settable: Bar { value: root.heater.power; fill: Theme.hot; }
        }
        Text {
            text: round(root.heater.temp * 10) / 10 + "°";
            color: Theme.text;
            font-size: 20px;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-alignment: right;
            width: 72px;
        }
        // Inset from the row's edges, so the frame stays clear of the separator lines
        if root.heater.settable: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 60px;
                height: 46px;
                background: Theme.surface-2;
                border-width: root.heater.target > 0 ? 2px : 0px;
                border-color: Theme.hot;
                Text {
                    text: root.heater.target > 0 ? round(root.heater.target) + "°" : @tr("off");
                    color: root.heater.target > 0 ? Theme.hot : Theme.text-dim;
                    font-size: Theme.font-m;
                }
            }
        }
        if !root.heater.settable: Rectangle { width: 60px; }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }

    ta := TouchArea {
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { Screensaver.activity(); } }
        enabled: root.heater.settable;
        clicked => { Overlay.edit-temp(root.heater); }
    }
}

component FanRow inherits VerticalLayout {
    in property <Fan> fan;
    spacing: 6px;
    HorizontalLayout {
        Text { text: Strings.fan-name(root.fan); color: Theme.text; overflow: elide; horizontal-stretch: 1; }
        Text { text: round(root.fan.speed * 100) + "%"; color: Theme.text; font-weight: 700; horizontal-stretch: 0; }
    }
    if root.fan.settable: FanSpeeds { fan-id: root.fan.id; speed: root.fan.speed; }
    if !root.fan.settable: Bar { value: root.fan.speed; }
}

// Nozzle and bed over the last minutes, as on an oscilloscope: newest on the right, one column
// per sample, targets as faint lines, a grid line every 50°.
component TempGraph inherits Rectangle {
    property <[TempSample]> samples: Printer.temp-history;
    property <float> top: Printer.temp-scale;
    property <length> column: self.width / Printer.temp-capacity;
    clip: true;

    pure function level-y(t: float) -> length {
        return (root.height - 2px) * (1 - clamp(t / root.top, 0, 1));
    }

    for g in floor(root.top / 50): Rectangle {
        y: root.level-y((g + 1) * 50);
        height: 1px;
        background: Theme.border.transparentize(0.4);
    }
    Rectangle { y: root.height - 1px; height: 1px; background: Theme.border; }
    Text {
        x: 2px;
        y: root.level-y(root.top - 50) + 2px;
        text: round(root.top - 50) + "°";
        color: Theme.text-dim;
        font-size: 11px;
    }

    for h in Printer.top-heaters: Rectangle {
        visible: h.target > 0;
        y: root.level-y(h.target);
        height: 1px;
        background: Theme.hot.transparentize(0.45);
    }

    // Each column joins the previous sample to this one, so the line has no gaps
    for s[i] in root.samples: Rectangle {
        property <TempSample> prev: i > 0 ? root.samples[i - 1] : s;
        x: root.width - (root.samples.length - i) * root.column;
        width: root.column + 0.5px;
        if s.bed >= 0: Rectangle {
            property <length> a: root.level-y(parent.prev.bed >= 0 ? parent.prev.bed : s.bed);
            property <length> b: root.level-y(s.bed);
            y: min(self.a, self.b);
            height: abs(self.a - self.b) + 2px;
            background: Theme.text-dim;
        }
        if s.nozzle >= 0: Rectangle {
            property <length> a: root.level-y(parent.prev.nozzle >= 0 ? parent.prev.nozzle : s.nozzle);
            property <length> b: root.level-y(s.nozzle);
            y: min(self.a, self.b);
            height: abs(self.a - self.b) + 2px;
            background: Theme.text;
        }
    }
}

// Three columns: heaters and sensors, fans, presets.
export component TemperaturePage inherits Rectangle {
    HorizontalLayout {
        padding: Theme.gap;
        spacing: Theme.gap;

        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        for h in Printer.heaters: HeaterRow { heater: h; }
                        for s in Printer.sensors: HeaterRow { heater: s; }
                    }
                }
                if Printer.top-heaters.length > 0: VerticalLayout {
                    vertical-stretch: 0;
                    padding: 10px;
                    padding-top: 6px;
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 12px;
                        for h in Printer.top-heaters: HorizontalLayout {
                            spacing: 5px;
                            horizontal-stretch: 0;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 10px;
                                    height: 3px;
                                    background: h.role == "bed" ? Theme.text-dim : Theme.text;
                                }
                            }
                            Caption { text: Strings.heater-name(h); font-size: 12px; }
                        }
                        Caption { text: @tr("{} min", 5); font-size: 12px; horizontal-alignment: right; horizontal-stretch: 1; }
                    }
                    TempGraph { height: 110px; }
                }
            }
        }

        Card {
            width: 256px;
            VerticalLayout {
                padding: 10px;
                spacing: 14px;
                alignment: start;
                HorizontalLayout {
                    spacing: 8px;
                    Image { source: @image-url("../icons/fan.svg"); colorize: Theme.text-dim; width: 20px; height: 20px; }
                    Caption { text: @tr("Fans"); }
                }
                for f in Printer.fans: FanRow { fan: f; }
            }
        }

        Card {
            width: 118px;
            VerticalLayout {
                padding: Theme.gap;
                spacing: Theme.gap;
                Caption { text: @tr("Presets"); }
                for p in Printer.presets: Btn {
                    text: p.name;
                    clicked => {
                        Actions.set-temp("extruder", p.extruder);
                        Actions.set-temp("heater_bed", p.bed);
                    }
                }
                Rectangle { vertical-stretch: 1; }
                Btn {
                    text: @tr("Heaters off");
                    wrap: true;
                    kind: BtnKind.danger;
                    font-size: Theme.font-s;
                    clicked => { Actions.gcode("TURN_OFF_HEATERS"); }
                }
            }
        }
    }
}
