import { Theme } from "../theme.slint";
import { Printer, Actions, Overlay, Heater, Fan, Strings, Screensaver } from "../state.slint";
import { Btn, BtnKind, Card, Caption, Bar, FanSpeeds } from "../widgets.slint";
import { ScrollView } from "std-widgets.slint";

component HeaterRow inherits Rectangle {
    in property <Heater> heater;
    height: 64px;
    background: ta.pressed ? Theme.surface-2 : transparent;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 1;
            // Long names (e.g. "Raspberry pi") take a second line
            Text { text: Strings.heater-name(root.heater); color: Theme.text; wrap: word-wrap; overflow: elide; }
            if root.heater.settable: Bar { value: root.heater.power; fill: Theme.hot; }
        }
        Text {
            text: round(root.heater.temp * 10) / 10 + "°";
            color: Theme.text;
            font-size: 20px;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-alignment: right;
            width: 72px;
        }
        // Inset from the row's edges, so the frame stays clear of the separator lines
        if root.heater.settable: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 60px;
                height: 46px;
                background: Theme.surface-2;
                border-width: root.heater.target > 0 ? 2px : 0px;
                border-color: Theme.hot;
                Text {
                    text: root.heater.target > 0 ? round(root.heater.target) + "°" : @tr("off");
                    color: root.heater.target > 0 ? Theme.hot : Theme.text-dim;
                    font-size: Theme.font-m;
                }
            }
        }
        if !root.heater.settable: Rectangle { width: 60px; }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }

    ta := TouchArea {
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { Screensaver.activity(); } }
        enabled: root.heater.settable;
        clicked => { Overlay.edit-temp(root.heater); }
    }
}

component FanRow inherits VerticalLayout {
    in property <Fan> fan;
    spacing: 6px;
    HorizontalLayout {
        Text { text: Strings.fan-name(root.fan); color: Theme.text; overflow: elide; horizontal-stretch: 1; }
        Text { text: round(root.fan.speed * 100) + "%"; color: Theme.text; font-weight: 700; horizontal-stretch: 0; }
    }
    if root.fan.settable: FanSpeeds { fan-id: root.fan.id; speed: root.fan.speed; }
    if !root.fan.settable: Bar { value: root.fan.speed; }
}

// Three columns: heaters and sensors, fans, presets.
export component TemperaturePage inherits Rectangle {
    HorizontalLayout {
        padding: Theme.gap;
        spacing: Theme.gap;

        Card {
            horizontal-stretch: 1;
            ScrollView {
                VerticalLayout {
                    alignment: start;
                    for h in Printer.heaters: HeaterRow { heater: h; }
                    for s in Printer.sensors: HeaterRow { heater: s; }
                }
            }
        }

        Card {
            width: 256px;
            VerticalLayout {
                padding: 10px;
                spacing: 14px;
                alignment: start;
                HorizontalLayout {
                    spacing: 8px;
                    Image { source: @image-url("../icons/fan.svg"); colorize: Theme.text-dim; width: 20px; height: 20px; }
                    Caption { text: @tr("Fans"); }
                }
                for f in Printer.fans: FanRow { fan: f; }
            }
        }

        Card {
            width: 118px;
            VerticalLayout {
                padding: Theme.gap;
                spacing: Theme.gap;
                Caption { text: @tr("Presets"); }
                for p in Printer.presets: Btn {
                    text: p.name;
                    clicked => {
                        Actions.set-temp("extruder", p.extruder);
                        Actions.set-temp("heater_bed", p.bed);
                    }
                }
                Rectangle { vertical-stretch: 1; }
                Btn {
                    text: @tr("Heaters off");
                    wrap: true;
                    kind: BtnKind.danger;
                    font-size: Theme.font-s;
                    clicked => { Actions.gcode("TURN_OFF_HEATERS"); }
                }
            }
        }
    }
}
