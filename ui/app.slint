// Bundled fonts (SIL Open Font License, see ui/fonts/OFL.txt)
import "fonts/MartianMonoCondensed-Regular.ttf";
import "fonts/MartianMonoCondensed-SemiBold.ttf";
import "fonts/MartianMonoCondensed-Bold.ttf";

import { Theme } from "theme.slint";
import { Printer, Actions, Overlay, Nav, Conn, Status, Settings, Strings, Messages, Network, Update, Screensaver } from "state.slint";
import { Btn, BtnKind } from "widgets.slint";
import { NumpadDialog, ConfirmDialog, FileDialog, TextDialog, NotReadyPanel, TuneSheet, StandBy } from "dialogs.slint";
import { DashboardPage } from "pages/dashboard.slint";
import { TemperaturePage } from "pages/temperature.slint";
import { MovePage } from "pages/move.slint";
import { ExtrudePage } from "pages/extrude.slint";
import { FilesPage } from "pages/files.slint";
import { MacrosPage } from "pages/macros.slint";
import { ConsolePage } from "pages/console.slint";
import { SystemPage } from "pages/system.slint";
import { SettingsPage } from "pages/settings.slint";
import { PresetsPage } from "pages/presets.slint";
import { NetworkPage } from "pages/network.slint";
import { UpdatePage } from "pages/update.slint";
import { ZCalibratePage } from "pages/zcalibrate.slint";
import { BedMeshPage } from "pages/bedmesh.slint";
import { BedLevelPage } from "pages/bedlevel.slint";
import { PidPage } from "pages/pid.slint";
import { ExtruderCalibratePage } from "pages/extrudercal.slint";
import { ScreensaverView } from "screensaver.slint";

export { Printer, Actions, Overlay, Nav, Settings, Messages, Network, Update, Screensaver }

struct NavItem { text: string, page: int }
struct NavGroup { text: string, items: [NavItem] }

// The screens in five groups, shown as tabs along the bottom; the screens of the current group
// are listed down the left side.
global Sections {
    out property <[NavGroup]> groups: [
        { text: @tr("Status"), items: [
            { text: @tr("Home"), page: 0 },
        ] },
        { text: @tr("Control"), items: [
            { text: @tr("Move"), page: 2 },
            { text: @tr("Filament"), page: 3 },
            { text: @tr("Temperature"), page: 1 },
            { text: @tr("Macros"), page: 5 },
        ] },
        { text: @tr("Files"), items: [
            { text: @tr("Files"), page: 4 },
        ] },
        { text: @tr("Calibration"), items: [
            // Short names: the group's title already says it is calibration
            { text: @tr("Mesh"), page: 12 },
            { text: "Z", page: 11 },
            { text: @tr("Bed"), page: 14 },
            { text: @tr("Heater"), page: 15 },
            { text: @tr("Extruder"), page: 16 },
        ] },
        { text: @tr("System"), items: [
            { text: @tr("Information"), page: 7 },
            { text: @tr("Console"), page: 6 },
            { text: @tr("Settings"), page: 8 },
            { text: @tr("Presets"), page: 17 },
            { text: @tr("Network"), page: 9 },
            { text: @tr("Updates"), page: 10 },
        ] },
    ];

    out property <int> current: self.group-of(Nav.page);

    pure public function group-of(page: int) -> int {
        if (page == 0) { return 0; }
        if (page <= 3 || page == 5) { return 1; }
        if (page == 4) { return 2; }
        if (page >= 11 && page <= 16) { return 3; }
        return 4;
    }

    // Settings and Network read their current values on the way in
    public function go(page: int) {
        if (page == 8 || page == 17) { Settings.load(); }
        if (page == 9) { Network.load(); }
        Nav.page = page;
    }
}

// Pip-Boy style frame: a title on the top line with readouts hanging below it, the screens of the
// current group listed down the left side, and the groups as tabs on the bottom line.

// Readout under the top line, closed by a short tick on the right. The first one starts with a
// corner and the title sitting on the line.
component Readout inherits Rectangle {
    in property <string> title;
    property <length> line-y: 20px;
    property <length> line-start: root.title != "" ? title.x + title.width + 8px : 0;

    if root.title != "": Rectangle { x: 0; y: root.line-y; width: 2px; height: 24px; background: Theme.accent; }
    if root.title != "": Rectangle { x: 0; y: root.line-y; width: 12px; height: 2px; background: Theme.accent; }
    title := Text {
        x: 22px;
        y: root.line-y + 1px - self.height / 2;
        text: root.title;
        color: Theme.text;
        font-size: 22px;
        letter-spacing: 3px;
    }
    Rectangle { x: root.line-start; y: root.line-y; width: root.width - root.line-start; height: 2px; background: Theme.accent; }
    Rectangle { x: root.width - 2px; y: root.line-y; width: 2px; height: 24px; background: Theme.accent; }
    HorizontalLayout {
        x: root.line-start;
        y: root.line-y + 4px;
        width: root.width - root.line-start;
        height: 26px;
        padding-left: 8px;
        padding-right: 10px;
        spacing: 8px;
        alignment: end;
        @children
    }
}

component ReadoutText inherits Text {
    color: Theme.text;
    font-size: Theme.font-s;
    letter-spacing: 1px;
    vertical-alignment: center;
}

component Header inherits HorizontalLayout {
    height: 50px;
    padding-left: 14px;
    padding-right: 14px;
    spacing: 6px;

    // The group's name on the line, then the printer and its state
    Readout {
        horizontal-stretch: 1;
        title: Sections.groups[Sections.current].text.to-uppercase();
        ReadoutText {
            text: Strings.status(Printer.status);
            color: Printer.conn != Conn.ready ? Theme.danger-text
                : Printer.job.state == "paused" ? Theme.warn
                : Theme.text;
            horizontal-alignment: right;
            overflow: elide;
        }
        if Printer.printing: ReadoutText { text: round(Printer.job.progress * 100) + "%"; horizontal-stretch: 0; }
    }
    for h in Printer.top-heaters: Readout {
        width: 124px;
        VerticalLayout {
            alignment: center;
            Image {
                source: h.role == "bed" ? @image-url("icons/bed.svg") : @image-url("icons/nozzle.svg");
                colorize: h.target > 0 ? Theme.hot : Theme.text-dim;
                width: 16px;
                height: 16px;
            }
        }
        ReadoutText {
            text: round(h.temp) + "°" + (h.target > 0 ? "/" + round(h.target) + "°" : "");
            color: h.target > 0 ? Theme.hot : Theme.text;
        }
    }
    Readout {
        width: 72px;
        ReadoutText { text: Printer.clock; }
    }
    // Emergency stop: acts immediately, like Klipper's own (heaters and motors off,
    // firmware restart needed). Three clockwise arrows as on a "twist to release" button.
    VerticalLayout {
        alignment: center;
        padding-left: 4px;
        padding-top: 4px;
        Btn {
            width: 44px;
            height: 40px;
            icon: @image-url("icons/estop.svg");
            icon-size: 24px;
            kind: BtnKind.danger;
            accessible-label: @tr("Emergency stop");
            clicked => { Actions.emergency-stop(); }
        }
    }
}

// The screens of the current group, down the left side; the current one is boxed. Groups of one
// screen have none.
component SideMenu inherits VerticalLayout {
    property <[NavItem]> items: Sections.groups[Sections.current].items;
    width: 128px;
    padding-left: 14px;
    padding-top: 8px;
    spacing: 4px;
    alignment: start;

    for it in root.items: Rectangle {
        height: 44px;
        background: it.page == Nav.page ? Theme.accent.transparentize(0.88)
            : ta.pressed ? Theme.surface-2 : transparent;
        accessible-role: tab;
        accessible-label: it.text;
        accessible-action-default => { Sections.go(it.page); }
        if it.page == Nav.page: Rectangle { x: 0; width: 2px; background: Theme.accent; }
        if it.page == Nav.page: Rectangle { x: parent.width - 2px; width: 2px; background: Theme.accent; }
        Text {
            x: 9px;
            width: parent.width - 14px;
            height: parent.height;
            text: it.text.to-uppercase();
            color: Theme.text;
            font-size: 13px;
            wrap: word-wrap;
            vertical-alignment: center;
        }
        ta := TouchArea {
            pointer-event(e) => { if (e.kind == PointerEventKind.down) { Screensaver.activity(); } }
            clicked => { Sections.go(it.page); }
        }
    }
}

// Piece of the bottom line between tabs; the outer ones end in a tick going up.
component BottomLine inherits Rectangle {
    in property <bool> tick-left;
    in property <bool> tick-right;
    Rectangle { y: parent.height / 2 - 1px; height: 2px; background: Theme.accent; }
    if root.tick-left: Rectangle { x: 0; y: parent.height / 2 - 22px; width: 2px; height: 23px; background: Theme.accent; }
    if root.tick-right: Rectangle { x: parent.width - 2px; y: parent.height / 2 - 22px; width: 2px; height: 23px; background: Theme.accent; }
}

component BottomTab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();

    width: label.preferred-width + 24px;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    Rectangle {
        height: 36px;
        background: root.active ? Theme.accent.transparentize(0.88) : ta.pressed ? Theme.surface-2 : transparent;
        border-width: root.active ? 2px : 0px;
        border-color: Theme.accent;
    }
    label := Text {
        text: root.text;
        color: Theme.text;
        font-size: Theme.font-m;
        letter-spacing: 1px;
    }
    ta := TouchArea {
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { Screensaver.activity(); } }
        clicked => { root.clicked(); }
    }
}

component BottomTabs inherits HorizontalLayout {
    height: 46px;
    padding-left: 14px;
    padding-right: 14px;
    padding-bottom: 6px;

    BottomLine { width: 40px; tick-left: true; }
    for g[i] in Sections.groups: HorizontalLayout {
        horizontal-stretch: 1;
        BottomTab {
            text: g.text;
            active: i == Sections.current;
            clicked => {
                if (i != Sections.current) {
                    Sections.go(g.items[0].page);
                }
            }
        }
        BottomLine { horizontal-stretch: 1; tick-right: i == Sections.groups.length - 1; }
    }
}

export component AppWindow inherits Window {
    title: "Klipper Helm";
    // Desktop preview of the printer's screen (KLIPPER_HELM_SCREEN): the panel is drawn at this
    // logical size in the middle of the window, whatever size the window manager gives it;
    // 0 fills the window
    in property <length> fixed-width: 0px;
    in property <length> fixed-height: 0px;
    property <bool> framed: root.fixed-width > 0 && root.fixed-height > 0;
    preferred-width: root.framed ? root.fixed-width : 800px;
    preferred-height: root.framed ? root.fixed-height : 480px;
    background: root.framed ? #000000 : Theme.bg;
    default-font-family: Theme.font;
    default-font-size: Theme.font-m;

    // Console, System and Settings also work when Klipper is not ready
    property <bool> blocked: Printer.conn != Conn.ready && (Nav.page < 6 || (Nav.page >= 11 && Nav.page <= 16));

    // The end of a print and Klipper failures wake the screen
    property <Status> status: Printer.status;
    changed status => {
        if (status == Status.complete || status == Status.print-error || status == Status.cancelled
            || status == Status.klipper-shutdown || status == Status.klipper-error) {
            Screensaver.wake();
        }
    }

    screen := Rectangle {
        width: root.framed ? min(root.width, root.fixed-width) : root.width;
        height: root.framed ? min(root.height, root.fixed-height) : root.height;
        clip: root.framed;
        background: Theme.bg;

        VerticalLayout {
            Header {}
            HorizontalLayout {
                vertical-stretch: 1;
                padding-left: Sections.groups[Sections.current].items.length > 1 ? 0 : 4px;
                padding-right: 4px;
                if Sections.groups[Sections.current].items.length > 1: SideMenu {}
                // Pages add their own 10 px
                Rectangle {
                    horizontal-stretch: 1;
                    if root.blocked: NotReadyPanel { width: 100%; height: 100%; }
                    if !root.blocked && Nav.page == 0: DashboardPage { width: 100%; height: 100%; }
                    if !root.blocked && Nav.page == 1: TemperaturePage { width: 100%; height: 100%; }
                    if !root.blocked && Nav.page == 2: MovePage { width: 100%; height: 100%; }
                    if !root.blocked && Nav.page == 3: ExtrudePage { width: 100%; height: 100%; }
                    if !root.blocked && Nav.page == 4: FilesPage { width: 100%; height: 100%; }
                    if !root.blocked && Nav.page == 5: MacrosPage { width: 100%; height: 100%; }
                    if Nav.page == 6: ConsolePage { width: 100%; height: 100%; }
                    if Nav.page == 7: SystemPage { width: 100%; height: 100%; }
                    if Nav.page == 8: SettingsPage { width: 100%; height: 100%; }
                    if Nav.page == 9: NetworkPage { width: 100%; height: 100%; }
                    if Nav.page == 10: UpdatePage { width: 100%; height: 100%; }
                    if Nav.page == 17: PresetsPage { width: 100%; height: 100%; }
                    if !root.blocked && Nav.page == 11: ZCalibratePage { width: 100%; height: 100%; }
                    if !root.blocked && Nav.page == 12: BedMeshPage { width: 100%; height: 100%; }
                    if !root.blocked && Nav.page == 14: BedLevelPage { width: 100%; height: 100%; }
                    if !root.blocked && Nav.page == 15: PidPage { width: 100%; height: 100%; }
                    if !root.blocked && Nav.page == 16: ExtruderCalibratePage { width: 100%; height: 100%; }
                }
            }
            BottomTabs {}
        }

        // Starting up: "Please stand by" over the whole screen until Moonraker answers (or fails to)
        if Printer.conn == Conn.connecting: Rectangle {
            background: Theme.bg;
            TouchArea {}
            StandBy {}
        }

        if Overlay.tune-open: TuneSheet { width: 100%; height: 100%; }
        if Overlay.numpad-open: NumpadDialog { width: 100%; height: 100%; }
        if Overlay.confirm-open: ConfirmDialog { width: 100%; height: 100%; }
        if Overlay.file-open: FileDialog { width: 100%; height: 100%; }
        if Overlay.text-open: TextDialog { width: 100%; height: 100%; }

        if Printer.toast != "": Rectangle {
            y: parent.height - self.height - 48px;
            width: min(parent.width - 32px, 560px);
            height: 52px;
            background: Theme.surface-2;
            border-width: 2px;
            border-color: Printer.toast-error ? Theme.danger : Theme.accent;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                Text {
                    text: "> " + Printer.toast;
                    color: Printer.toast-error ? Theme.danger-text : Theme.text;
                    font-size: Theme.font-s;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            TouchArea { clicked => { Printer.toast = ""; } }
            Timer {
                interval: 5s;
                running: true;
                triggered => { Printer.toast = ""; }
            }
        }

        if Screensaver.active: ScreensaverView { width: 100%; height: 100%; }

        // Tube effect over everything: scanlines and darker corners. Images let touches through.
        // Both are pictures: a full-screen gradient costs several times more CPU with the
        // software renderer on the Pi.
        Image {
            width: 100%;
            height: 100%;
            source: @image-url("icons/scanlines.png");
            horizontal-tiling: repeat;
            vertical-tiling: repeat;
        }
        Image {
            width: 100%;
            height: 100%;
            source: @image-url("icons/vignette.png");
            image-fit: fill;
        }
    }
}
