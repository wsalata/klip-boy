import { Theme } from "theme.slint";
import { Screensaver, Actions, Status } from "state.slint";

// danger-outline: a destructive action that is not an emergency (e.g. cancelling a print)
export enum BtnKind { normal, accent, danger, danger-outline, ghost }

export component Btn inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <BtnKind> kind: BtnKind.normal;
    in property <bool> enabled: true;
    in property <bool> active;
    in property <length> font-size: Theme.font-m;
    in property <length> icon-size: 22px;
    // A long label takes a second line (at spaces) rather than being cut short
    in property <bool> wrap;
    callback clicked();

    property <color> base: root.active ? Theme.accent
        : root.kind == BtnKind.accent ? Theme.accent
        : root.kind == BtnKind.danger ? Theme.danger
        : root.kind == BtnKind.ghost || root.kind == BtnKind.danger-outline ? transparent
        : Theme.surface-2;
    // Disabled keys are hollow with faded text, clearly apart from any working key
    property <color> fg: !root.enabled ? Theme.text-dim.transparentize(0.55)
        : ta.pressed && root.kind != BtnKind.danger && root.kind != BtnKind.danger-outline ? Theme.on-accent
        : (root.active || root.kind == BtnKind.accent) ? Theme.on-accent
        : root.kind == BtnKind.danger ? #ffffff
        : root.kind == BtnKind.danger-outline ? (ta.pressed ? #ffffff : Theme.danger-text)
        : Theme.text;

    min-height: 48px;
    min-width: 48px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }
    // Outlined keys; disabled ones keep only a faint outline
    border-width: root.enabled && (root.kind == BtnKind.accent || root.kind == BtnKind.danger || root.active) ? 0px : 1px;
    border-color: !root.enabled ? Theme.border.transparentize(0.4)
        : root.kind == BtnKind.danger-outline ? Theme.danger-border : Theme.border;
    // A pressed key lights up like a highlighted terminal line
    background: !root.enabled ? transparent
        : ta.pressed ? (root.kind == BtnKind.danger || root.kind == BtnKind.danger-outline ? Theme.danger.darker(0.3) : Theme.accent.darker(0.25))
        : root.base;
    animate background { duration: 80ms; }

    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        padding-left: root.text != "" ? 10px : 8px;
        padding-right: root.text != "" ? 10px : 8px;
        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                colorize: root.fg;
                width: root.icon-size;
                height: root.icon-size;
            }
        }
        if root.text != "": Text {
            text: root.text;
            color: root.fg;
            font-size: root.font-size;
            vertical-alignment: center;
            horizontal-alignment: center;
            wrap: root.wrap ? word-wrap : no-wrap;
            overflow: elide;
        }
    }

    ta := TouchArea {
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { Screensaver.activity(); } }
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Print thumbnail; slicers render them on a transparent background. Rust sends a brightness
// mask (thumbs::luminance_mask), drawn here in the phosphor colour.
export component Thumb inherits Rectangle {
    in property <image> source;
    background: Theme.surface;
    clip: true;
    Image {
        source: root.source;
        colorize: Theme.text;
        width: parent.width;
        height: parent.height;
        image-fit: contain;
    }
}

// Framed panel with corner marks, as on a terminal readout.
export component Card inherits Rectangle {
    background: Theme.surface.transparentize(0.4);
    border-width: 1px;
    border-color: Theme.border;
    for c in [{ x: 0, y: 0 }, { x: 1, y: 0 }, { x: 0, y: 1 }, { x: 1, y: 1 }]: Rectangle {
        x: c.x * (root.width - self.width);
        y: c.y * (root.height - self.height);
        width: 10px;
        height: 10px;
        Rectangle { x: 0; y: c.y * (parent.height - 2px); width: parent.width; height: 2px; background: Theme.accent; }
        Rectangle { x: c.x * (parent.width - 2px); y: 0; width: 2px; height: parent.height; background: Theme.accent; }
    }
    @children
}

export component Caption inherits Text {
    color: Theme.text-dim;
    font-size: Theme.font-s;
    vertical-alignment: center;
    overflow: elide;
}

// Pick one of several options (e.g. the jog step).
export component Segmented inherits HorizontalLayout {
    in property <[string]> items;
    in-out property <int> selected;
    spacing: 4px;
    for item[i] in root.items: Btn {
        text: item;
        font-size: Theme.font-s;
        active: i == root.selected;
        clicked => { root.selected = i; }
    }
}

// Row of blocks, lit from the left up to `value` (0..1), as on a Pip-Boy gauge. Only whole
// blocks are lit; the last one is lit as soon as the value reaches into it.
export component Segments inherits Rectangle {
    in property <float> value;
    in property <color> fill: Theme.accent;
    in property <color> empty: Theme.surface-2;
    in property <length> block: 6px;
    in property <length> spacing: 2px;
    // The leading lit block blinks (e.g. while printing)
    in property <bool> blink;
    property <int> count: max(1, floor((root.width + root.spacing) / (root.block + root.spacing)));
    property <int> lit: ceil(clamp(root.value, 0, 1) * root.count - 0.001);
    // Blocks stretched a little so the row ends flush with the right edge
    property <length> step: (root.width + root.spacing) / root.count;
    for i in root.count: Rectangle {
        x: i * root.step;
        width: root.step - root.spacing;
        height: root.height;
        background: i >= root.lit ? root.empty
            // animation-tick() is only read while blinking, so a still bar does not redraw
            : root.blink && i == root.lit - 1 ? (mod(animation-tick(), 1000ms) >= 500ms ? root.fill.transparentize(0.65) : root.fill)
            : root.fill;
    }
}

export component Bar inherits Segments {
    height: 6px;
}

// Single-line text with a cursor between the parts before and after it.
export component CursorText inherits HorizontalLayout {
    in property <string> before;
    in property <string> after;
    in property <string> placeholder;
    alignment: start;
    Text {
        text: root.before;
        color: Theme.text;
        vertical-alignment: center;
    }
    Rectangle {
        width: 2px;
        background: Theme.accent;
    }
    Text {
        text: root.after;
        color: Theme.text;
        vertical-alignment: center;
    }
    if root.before == "" && root.after == "": Text {
        text: root.placeholder;
        color: Theme.text-dim;
        vertical-alignment: center;
    }
}

// "label  value" row for info cards.
export component InfoRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 8px;
    Caption { text: root.label; horizontal-stretch: 0; }
    Text {
        text: root.value;
        color: Theme.text;
        horizontal-alignment: right;
        horizontal-stretch: 1;
        overflow: elide;
    }
}

// Fan speed presets. The tapped preset lights up at once; Klipper applies M106 only after the
// moves already queued, so its reported speed follows a moment later.
export component FanSpeeds inherits HorizontalLayout {
    in property <string> fan-id;
    in property <float> speed;
    // Preset tapped since the last speed report, -1 when none
    property <int> chosen: -1;
    changed speed => { root.chosen = -1; }
    spacing: 4px;
    for v in [0, 25, 50, 75, 100]: Btn {
        text: v + "";
        font-size: Theme.font-s;
        min-height: 40px;
        min-width: 40px;
        active: (root.chosen >= 0 ? root.chosen : round(root.speed * 100)) == v;
        clicked => {
            root.chosen = v;
            Actions.set-fan(root.fan-id, v / 100);
        }
    }
}

// "label  value" box whose value is a key that opens the numpad.
export component ValueBox inherits Rectangle {
    in property <string> label;
    in property <string> value;
    callback clicked();
    // Darker than the keys inside, so they read as buttons
    background: Theme.bg;
    height: 80px;
    preferred-width: 200px;
    horizontal-stretch: 1;
    HorizontalLayout {
        padding: 12px;
        spacing: 10px;
        Caption { text: root.label; overflow: elide; horizontal-stretch: 1; }
        Btn {
            text: root.value;
            width: 120px;
            font-size: Theme.font-l;
            accessible-label: root.label;
            clicked => { root.clicked(); }
        }
    }
}

// Step adjustment with - and + (Z offset).
export component Stepper inherits Rectangle {
    in property <string> label;
    in property <string> value;
    callback minus();
    callback plus();
    // Darker than the keys inside, so they read as buttons
    background: Theme.bg;
    height: 80px;
    // Equal widths side by side
    preferred-width: 200px;
    horizontal-stretch: 1;
    HorizontalLayout {
        padding: 12px;
        spacing: 10px;
        Btn {
            text: "-";
            width: 56px;
            font-size: Theme.font-l;
            accessible-label: @tr("Decrease {}", root.label);
            clicked => { root.minus(); }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Caption { text: root.label; horizontal-alignment: center; overflow: elide; }
            Text {
                text: root.value;
                color: Theme.text;
                font-size: Theme.font-l;
                font-weight: 600;
                horizontal-alignment: center;
            }
        }
        Btn {
            text: "+";
            width: 56px;
            font-size: Theme.font-l;
            accessible-label: @tr("Increase {}", root.label);
            clicked => { root.plus(); }
        }
    }
}

// Tappable "label  value" row that opens an editor.
export component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    callback clicked();
    height: 52px;
    background: ta.pressed ? Theme.border : Theme.surface-2;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        Caption { text: root.label; horizontal-stretch: 0; }
        Text {
            text: root.value;
            color: Theme.text;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
    ta := TouchArea {
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { Screensaver.activity(); } }
        clicked => { root.clicked(); }
    }
}

// Pixel-art picture of the printer's state (16x16 grid, drawn at whole multiples so the pixels
// stay sharp: 96px, 128px ...).
export component StateIcon inherits Image {
    in property <Status> status;
    property <Status> s: root.status;
    source: s == Status.ready ? @image-url("icons/state-ready.svg")
        : s == Status.printing ? @image-url("icons/state-printing.svg")
        : s == Status.paused ? @image-url("icons/state-paused.svg")
        : s == Status.complete ? @image-url("icons/state-complete.svg")
        : s == Status.cancelled ? @image-url("icons/state-cancelled.svg")
        : s == Status.print-error || s == Status.klipper-shutdown || s == Status.klipper-error ? @image-url("icons/state-error.svg")
        : s == Status.disconnected || s == Status.klipper-unavailable ? @image-url("icons/state-offline.svg")
        : @image-url("icons/state-busy.svg");
    colorize: s == Status.print-error || s == Status.klipper-shutdown || s == Status.klipper-error ? Theme.danger-text
        : s == Status.paused || s == Status.cancelled ? Theme.warn
        : Theme.text;
}
