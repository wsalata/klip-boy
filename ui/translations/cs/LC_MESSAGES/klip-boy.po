msgstr "Pomalu vytlačte {} mm. Příliš studené na extruzi (min. {}°)."

msgid "Extrude {} mm slowly (about 2 minutes) and wait until the motor stops."
msgstr "Pomalu vytlačte {} mm (asi 2 minuty) a počkejte, až se motor zastaví."

msgid "Extrude {} mm"
msgstr "Vytlačit {} mm"

